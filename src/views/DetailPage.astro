---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import '../styles/components/detail-content.css';
import type { NavSection } from '../i18n/routes';
import { ui, type Lang } from '../i18n/ui';
import type { JsonLd } from '../lib/structured-data';
import { COVER_PHOTO_ID } from '../lib/view-transitions';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternatePath: string;
  socialImage?: string;
  structuredData: JsonLd[];
  currentSection: NavSection;
  /** Stranica ima naslovnu fotografiju u koju slijeće fotografija iz kartice. */
  coverPhoto?: boolean;
}

const { lang, title, path, alternatePath, description, socialImage, structuredData, currentSection, coverPhoto } =
  Astro.props;
const { siteName, contentId } = ui[lang];
---

<BaseLayout
  lang={lang}
  title={`${title} — ${siteName}`}
  description={description}
  path={path}
  alternatePath={alternatePath}
  socialImage={socialImage}
  ogType="article"
  structuredData={structuredData}
  renderBlockingId={coverPhoto ? COVER_PHOTO_ID : undefined}
>
  <SkipLink lang={lang} target={contentId} />
  <SiteHeader lang={lang} variant="overlay" alternatePath={alternatePath} currentSection={currentSection} />
  <main id={contentId}>
    <slot />
  </main>
  <SiteFooter lang={lang} />
</BaseLayout>
