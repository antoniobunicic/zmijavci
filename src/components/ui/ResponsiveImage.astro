---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  /** Okomiti položaj motiva u okviru, u postocima (vidi .object-y-* u base.css). */
  focus?: number;
  /** Za glavnu sliku na stranici: učitava se odmah i s prioritetom. */
  priority?: boolean;
  quality?: number;
}

const { src, alt, widths, sizes, class: className, focus, priority = false, quality } = Astro.props;
// Manje fotografije koriste svoju punu širinu umjesto da stanu na prvoj manjoj veličini.
const usableWidths = widths.some((width) => width > src.width)
  ? [...widths.filter((width) => width < src.width), src.width]
  : widths;
---

<Picture
  src={src}
  alt={alt}
  formats={['avif']}
  fallbackFormat="webp"
  widths={usableWidths}
  sizes={sizes}
  quality={quality}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding="async"
  class:list={[className, focus && `object-y-${focus}`]}
/>
