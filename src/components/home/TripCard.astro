---
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import type { Trip } from '../../data/trips';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  trip: Trip;
}

const { lang, trip } = Astro.props;
---

<article class="trip card">
  <figure class="trip__img">
    <ResponsiveImage
      src={trip.image.src}
      alt={trip.image.alt[lang]}
      widths={[440, 800, 1150]}
      sizes="(max-width: 800px) 92vw, 440px"
    />
  </figure>
  <div class="trip__text">
    <h3>{trip.name[lang]}</h3>
    <p>{trip.description[lang]}</p>
  </div>
</article>
