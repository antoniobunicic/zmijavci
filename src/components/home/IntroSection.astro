---
import '../../styles/components/intro.css';
import Eyebrow from '../ui/Eyebrow.astro';
import LandmarkCarousel from './LandmarkCarousel.astro';
import { introCopy } from '../../data/intro';
import { sectionId } from '../../i18n/routes';
import type { Lang } from '../../i18n/ui';
import type { Landmark } from '../../lib/content';

interface Props {
  lang: Lang;
  landmarks: Landmark[];
}

const { lang, landmarks } = Astro.props;
const copy = introCopy[lang];
---

<section id={sectionId('intro', lang)} class="section intro section--white">
  <div class="container intro__head">
    <Eyebrow tone="accent">{copy.eyebrow}</Eyebrow>
    <p class="intro__lead" data-word-reveal>
      {copy.lead.split(' ').map((word) => <span class="intro__word">{word} </span>)}
    </p>
  </div>
  <LandmarkCarousel lang={lang} landmarks={landmarks} />
</section>

<script src="../../scripts/word-reveal.ts"></script>
