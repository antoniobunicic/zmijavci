---
import '../../styles/components/cover-gallery.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  photos: { image: ImageMetadata; alt: string }[];
}

const LIGHTBOX_WIDTH = 2000;

const { lang, photos } = Astro.props;
const copy = ui[lang].coverGallery;
const slides = await Promise.all(
  photos.map(async (photo) => {
    const width = Math.min(LIGHTBOX_WIDTH, photo.image.width);
    const full = await getImage({ src: photo.image, width, format: 'webp', quality: 85 });
    return { ...photo, full: full.src };
  }),
);
---

<div class="cover-gallery" data-cover-gallery>
  <figure class="event-hero__img cover-gallery__frame">
    <div class="cover-gallery__track" data-cover-track>
      {
        slides.map(({ image, alt, full }, index) => (
          <button type="button" class="cover-gallery__slide" data-full={full} data-alt={alt} aria-label={`${copy.open}: ${alt}`}>
            <ResponsiveImage
              src={image}
              alt={alt}
              widths={[640, 960, 1320, 1600]}
              sizes="(max-width: 1432px) 92vw, 1320px"
              priority={index === 0}
            />
          </button>
        ))
      }
    </div>
    <button type="button" class="gallery-arrow gallery-arrow--prev" data-cover-prev aria-label={copy.previous}>←</button>
    <button type="button" class="gallery-arrow gallery-arrow--next" data-cover-next aria-label={copy.next}>→</button>
    <p class="cover-gallery__count" aria-hidden="true"><span data-cover-current>1</span> / {slides.length}</p>
  </figure>

  <dialog class="lightbox" data-cover-dialog aria-label={copy.dialog}>
    <img class="lightbox__img" data-cover-full alt="" />
    <button type="button" class="gallery-arrow lightbox__close" data-cover-close aria-label={copy.close}>×</button>
    <button type="button" class="gallery-arrow gallery-arrow--prev" data-lightbox-prev aria-label={copy.previous}>←</button>
    <button type="button" class="gallery-arrow gallery-arrow--next" data-lightbox-next aria-label={copy.next}>→</button>
  </dialog>
</div>

<script src="../../scripts/cover-gallery.ts"></script>
