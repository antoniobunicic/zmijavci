---
import '../../styles/components/award.css';
import type { ImageMetadata } from 'astro';
import ResponsiveImage from '../ui/ResponsiveImage.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  eyebrow: string;
  title: string;
  text: string;
}

const { image, imageAlt, eyebrow, title, text } = Astro.props;
---

<div class="award">
  <figure class="award__img">
    <ResponsiveImage src={image} alt={imageAlt} widths={[520, 1040]} sizes="(max-width: 640px) 92vw, 520px" />
  </figure>
  <div class="award__text">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p>{text}</p>
  </div>
</div>
