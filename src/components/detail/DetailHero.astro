---
import '../../styles/components/detail-hero.css';
import '../../styles/components/event-date.css';
import type { ImageMetadata } from 'astro';
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  parent: { label: string; href: string };
  breadcrumb: string;
  title: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageFocus?: number;
}

const { lang, parent, breadcrumb, title, lead, image, imageAlt = '', imageFocus } = Astro.props;
---

<section class:list={['event-hero', { 'event-hero--plain': !image }]}>
  <div class="event-hero__bg" aria-hidden="true">
    {image && <ResponsiveImage src={image} alt="" widths={[640]} sizes="100vw" quality={40} />}
  </div>
  <div class="container">
    <nav class="breadcrumb" aria-label={ui[lang].breadcrumb}>
      <a href={parent.href}>{parent.label}</a>
      <span aria-hidden="true">/</span>
      <span>{breadcrumb}</span>
    </nav>
    <slot />
    <h1>{title}</h1>
    <p class="event-hero__lead">{lead}</p>
    {
      image && (
        <figure class="event-hero__img">
          <ResponsiveImage
            src={image}
            alt={imageAlt}
            focus={imageFocus}
            widths={[640, 960, 1320, 1600]}
            sizes="(max-width: 1432px) 92vw, 1320px"
            priority
          />
        </figure>
      )
    }
  </div>
</section>
