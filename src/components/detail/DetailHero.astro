---
import '../../styles/components/detail-hero.css';
import '../../styles/components/event-date.css';
import type { ImageMetadata } from 'astro';
import ResponsiveImage from '../ui/ResponsiveImage.astro';
import CoverGallery from './CoverGallery.astro';
import Snowfall from './Snowfall.astro';
import { ui, type Lang } from '../../i18n/ui';
import { COVER_PHOTO_ID } from '../../lib/view-transitions';

interface Props {
  lang: Lang;
  parent: { label: string; href: string };
  breadcrumb: string;
  title: string;
  lead: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageFocus?: number;
  /** Dodatne fotografije: naslovna tada postaje galerija sa strelicama. */
  extraPhotos?: { image: ImageMetadata; alt: string }[];
  /** Tamna pozadina s padajućim snijegom umjesto zamućene fotografije. */
  snow?: boolean;
  /** Putanja ove stranice: kartica s istim ključem pri prijelazu „preleti” u ovu fotografiju. */
  photoKey?: string;
}

const { lang, parent, breadcrumb, title, lead, image, imageAlt = '', imageFocus, extraPhotos, snow = false, photoKey } = Astro.props;
---

<section class:list={['event-hero', { 'event-hero--plain': !image, 'event-hero--snow': snow }]}>
  <div class="event-hero__bg" aria-hidden="true">
    {snow ? <Snowfall /> : image && <ResponsiveImage src={image} alt="" widths={[640]} sizes="100vw" quality={40} />}
  </div>
  <div class="container">
    <nav class="breadcrumb" aria-label={ui[lang].breadcrumb}>
      <a href={parent.href}>{parent.label}</a>
      <span aria-hidden="true">/</span>
      <span>{breadcrumb}</span>
    </nav>
    <div class="event-hero__head">
      <div class="event-hero__intro">
        <slot />
        <h1>{title}</h1>
        <p class="event-hero__lead">{lead}</p>
      </div>
      <slot name="aside" />
    </div>
    {
      image && extraPhotos ? (
        <CoverGallery lang={lang} photos={[{ image, alt: imageAlt }, ...extraPhotos]} photoKey={photoKey} />
      ) : image && (
        <figure class="event-hero__img" id={COVER_PHOTO_ID} data-vt-photo={photoKey}>
          <ResponsiveImage
            src={image}
            alt={imageAlt}
            focus={imageFocus}
            widths={[640, 960, 1320, 1600]}
            sizes="(max-width: 1432px) 92vw, 1320px"
            priority
          />
        </figure>
      )
    }
  </div>
</section>
